{"id":"subsystem:rendering-gl","name":"Rendering and GL","aliases":["rendering","renderer","opengl","graphics"],"cues":["gles","opengl","egl","gl","shader","shaders","texture","textures","black screen","renders","rendering","render","crash","sigsegv","segfault"],"summary":"Renderer, GL/GLES driver and translation layers, shaders and textures."}
{"id":"subsystem:binary-recon","name":"Executable recon","aliases":["binary recon","executable recon","exe recon"],"cues":["rtti","symbols","symbol","stripped","vtable","vtables","class names","exe","executable","disassembly","signature","signatures","xref","string","strings","no symbols","classes"],"summary":"Understanding a binary without source: triage, RTTI classes, string-to-function pivots, tables, signatures."}
{"id":"subsystem:matching-decomp","name":"Function matching workflow","aliases":["decomp matching","function matching","objdiff","asm-differ"],"cues":["match","matching","matches","mismatch","objdiff","regswap","register swap","compiler flags","decompiled","decompile","refuses","diff","asm","assembly","byte-for-byte","tie-break","inline","inlining","score"],"summary":"Making recompiled source equal the original object code byte for byte, function by function."}
