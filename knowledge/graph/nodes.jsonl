# Research graph nodes. One JSON object per line. id = <type>:<slug>; types: game engine tech compiler platform format struct subsystem technique approach project problem
# aliases = other names a person or agent would type (must be unique across nodes). cues = symptom words that suggest this node in `hub.py diagnose` (subsystem and problem nodes only).
# Add a node only when an edge, finding or experiment uses it; the builder rejects orphans. Rules and vocabulary: skills/gamedecomp-library/references/research-graph.md
{"id":"game:oblivion","name":"The Elder Scrolls IV: Oblivion","aliases":["Oblivion","TES4","TES IV","Elder Scrolls IV"],"summary":"Bethesda's 2006 RPG on Gamebryo with Havok; the Windows x86 Steam build is the reference build for the OpenOblivion port and for most measurements in this compendium."}
{"id":"game:morrowind","name":"The Elder Scrolls III: Morrowind","aliases":["Morrowind","TES3","TES III"],"summary":"The game OpenMW reimplements; OpenMW is the donor engine of the OpenOblivion port."}
{"id":"game:fallout-3","name":"Fallout 3","aliases":["FO3"],"summary":"Gamebryo-based Bethesda game; record headers are 24 bytes versus Oblivion's 20, so Oblivion parsers need changes."}
{"id":"game:fallout-new-vegas","name":"Fallout: New Vegas","aliases":["FNV","New Vegas"],"summary":"Gamebryo-based Bethesda game with an Xbox 360 MemDebug decomp in the catalog (human-only AI policy)."}
{"id":"game:halo-ce","name":"Halo: Combat Evolved","aliases":["Halo CE","Halo 1","Combat Evolved"],"summary":"First Halo game; data-driven Blam engine whose content is a graph of typed tags compiled into cache maps."}
{"id":"game:fallout-1","name":"Fallout (1997)","aliases":["Fallout 1"],"summary":"Isometric RPG with a playable drop-in reimplementation (Fallout CE) that reads the user's own data files."}
{"id":"game:black-and-white","name":"Black & White","aliases":["BW1","Black and White"],"summary":"2001 PC game with an MSVC 6 matching decompilation whose AGENTS.md is the best experiment-discipline text in the corpus."}
{"id":"game:zelda-majoras-mask","name":"The Legend of Zelda: Majora's Mask","aliases":["Majora's Mask","Majoras Mask","Zelda 64"],"summary":"N64 game with a static-recompilation PC port built on N64Recomp."}
{"id":"game:ogre-battle-64","name":"Ogre Battle 64: Person of Lordly Caliber","aliases":["Ogre Battle 64"],"summary":"N64 game statically recompiled to a native PC executable with N64Recomp."}
{"id":"game:sonic-unleashed","name":"Sonic Unleashed","aliases":["Sonic Unleashed Xbox 360"],"summary":"Xbox 360 game statically recompiled to Windows and Linux by UnleashedRecomp."}
{"id":"engine:gamebryo","name":"Gamebryo","aliases":["NetImmerse","Gamebryo engine"],"summary":"Scene-graph engine (Ni* classes: NiNode, NiAVObject, NiTriShape, controllers, streams) used by Oblivion and Fallout 3/NV; its model files are NIFs and its Bethesda physics blocks are bhk*."}
{"id":"engine:openmw","name":"OpenMW","aliases":["OpenMW engine"],"summary":"Open-source reimplementation of the Morrowind engine (Bullet physics, Lua API); the donor engine of OpenOblivion, pinned at two revisions (desktop and Android)."}
{"id":"engine:blam","name":"Blam engine","aliases":["Blam","Halo engine"],"summary":"Halo's data-driven engine: tags compiled into per-scenario cache maps, HaloScript bytecode, BSP structures."}
{"id":"tech:havok","name":"Havok Physics","aliases":["Havok","hk","bhk"],"summary":"Commercial physics middleware used by Gamebryo-era Bethesda games; Oblivion wraps it in bhk* classes and stores collision in NIF blocks."}
{"id":"tech:bullet","name":"Bullet Physics","aliases":["Bullet","bullet3"],"summary":"Open-source physics library used by OpenMW and the usual open backend for translating authored Havok collision."}
{"id":"tech:speedtree","name":"SpeedTree","aliases":["speed tree"],"summary":"Tree middleware; Oblivion ships trees as .spt data with SpeedTree* shader classes in the exe."}
{"id":"tech:gl4es","name":"GL4ES","aliases":["gl4es"],"summary":"OpenGL-on-GLES translation layer used by OpenMW-Android style ports; its load-time EGL call is part of a known start-up deadlock."}
{"id":"tech:opengl-es","name":"OpenGL ES","aliases":["GLES","GLES2","GLES3"],"summary":"Mobile graphics API; an arm64 app reaching it through the emulator's ARM translation layer is where the known emulator crash occurs."}
{"id":"compiler:msvc","name":"MSVC","aliases":["Microsoft Visual C++","Visual C++","VC++","cl.exe"],"summary":"Microsoft's C++ compiler; its RTTI layout is what rtti_scan.py reads and its code generation is what matching decomps reproduce."}
{"id":"platform:windows-x86","name":"Windows x86 (32-bit PC)","aliases":["Win32","PE32","Windows PC","x86 PC"],"summary":"32-bit Windows PE executables, the original platform of Oblivion and Black & White."}
{"id":"platform:windows-x64","name":"Windows x64","aliases":["Win64","x64 PE"],"summary":"64-bit Windows PE executables (Unity players, Unreal games, modern titles)."}
{"id":"platform:android-arm64","name":"Android ARM64","aliases":["arm64","aarch64","arm64-v8a","Android phone","Android"],"summary":"Phones; the target platform of OpenOblivion and most mobile ports."}
{"id":"platform:android-x86_64-emulator","name":"Android x86_64 emulator","aliases":["Android emulator","AVD","x86_64 emulator","emulator"],"summary":"Stock KVM emulator images; run arm64 apps through a translation layer unless the app ships x86_64 libraries."}
{"id":"platform:n64","name":"Nintendo 64","aliases":["N64"],"summary":"MIPS (VR4300) console; source platform of N64Recomp-based ports."}
{"id":"platform:xbox360","name":"Xbox 360","aliases":["X360","Xenon"],"summary":"PowerPC console; source platform of XenonRecomp-based ports and of the New Vegas MemDebug decomp."}
{"id":"fmt:nif","name":"NIF","aliases":["NIF model","Gamebryo file","NetImmerse file"],"summary":"Gamebryo model/scene file. Oblivion files are version 20.0.0.4/20.0.0.5 with Bethesda user versions; physics data are bhk* blocks."}
{"id":"fmt:bsa","name":"BSA archive","aliases":["BSA","Bethesda archive"],"summary":"Bethesda archive; Oblivion uses version 103 (voices, meshes, textures, menus)."}
{"id":"fmt:esm","name":"ESM/ESP plugin","aliases":["ESM","ESP","ESM/ESP","TES4 plugin"],"summary":"Bethesda record file: GRUP/record/subrecord layout, FormIDs, scripts, quests, dialogue, conditions."}
{"id":"fmt:spt","name":"SpeedTree .spt","aliases":[".spt","spt file"],"summary":"SpeedTree tree description; donor engines ignore it unless a converter draws the trees (OpenOblivion draws crossed billboards)."}
{"id":"fmt:halo-tag","name":"Halo tags and cache maps","aliases":["halo tag","halo tags","halo cache","halo map","halo maps"],"summary":"Typed tag files (four-character groups, blocks, references) compiled into per-scenario cache .map files."}
{"id":"struct:bhkCollisionObject","name":"bhkCollisionObject","aliases":["bhk collision object"],"summary":"NIF block that attaches a rigid body (and so a Havok shape) to a scene node; phantom and blend variants have their own classes."}
{"id":"struct:bhkRigidBody","name":"bhkRigidBody","aliases":["bhk rigid body","bhkRigidBodyT","rigid body"],"summary":"Havok body: layer and filter, motion type (fixed, keyframed, dynamic), quality, mass, friction, restitution, and its shape."}
{"id":"struct:bhkMoppBvTreeShape","name":"bhkMoppBvTreeShape","aliases":["bhk mopp bv tree shape","MOPP","MOPP tree"],"summary":"Havok bounding-volume tree code wrapped around a child shape; an acceleration structure whose bytes need not be executed to import the child triangles."}
{"id":"struct:bhkNiTriStripsShape","name":"bhkNiTriStripsShape","aliases":["bhk ni tri strips shape","tri strips shape","tristrips shape"],"summary":"Triangle-strip collision shape that references NiTriStripsData; in the measured stair meshes its vertices are already in visible-mesh units."}
{"id":"struct:bhkPackedNiTriStripsShape","name":"bhkPackedNiTriStripsShape","aliases":["bhk packed ni tri strips shape","packed tri strips","packed tristrips"],"summary":"Packed triangle collision shape; niftools documents a factor-of-7 vertex scale for it. Zero blocks occurred in the measured Oblivion slice."}
{"id":"struct:bhkConvexVerticesShape","name":"bhkConvexVerticesShape","aliases":["bhk convex vertices shape","convex hull shape"],"summary":"Convex hull collision shape, common for clutter and props."}
{"id":"struct:bhkBoxShape","name":"bhkBoxShape","aliases":["bhk box shape"],"summary":"Box primitive; half-extents multiplied by 7 reproduced the visible door slabs."}
{"id":"struct:bhkCapsuleShape","name":"bhkCapsuleShape","aliases":["bhk capsule shape"],"summary":"Capsule primitive, used in ragdoll limbs (the player skeleton's capsules are layer-8 limbs, not the controller)."}
{"id":"struct:bhkListShape","name":"bhkListShape","aliases":["bhk list shape"],"summary":"Shape that holds several sub-shapes."}
{"id":"struct:bhkSPCollisionObject","name":"bhkSPCollisionObject","aliases":["bhk sp collision object","simple phantom collision object"],"summary":"Collision object for a phantom (a volume that reports overlaps without pushing); used for trigger volumes."}
{"id":"struct:bhkBlendCollisionObject","name":"bhkBlendCollisionObject","aliases":["bhk blend collision object","ragdoll collision object"],"summary":"Collision object blended with animation, the ragdoll path (with bhkBlendController)."}
{"id":"struct:bhkCharacterController","name":"bhkCharacterController","aliases":["bhk character controller","bhkCharacterProxy","bhk character proxy","character proxy","character state"],"summary":"Oblivion's Havok character-controller family: controller, proxy, controller shape and OnGround/InAir/Jumping/Swimming/Flying/Projectile states."}
{"id":"subsystem:player-controller","name":"Player / character controller","aliases":["movement","player movement","character controller","player controller","locomotion","controller hull"],"cues":["player","walk","walks","walking","stairs","stair","upstairs","downstairs","steps","step","slope","ramp","grounded","ground","jump","jumping","catches","catch","snags","stuck","slides","slows","slow","rubber-band","speed","run","sneak","falls","capsule"],"summary":"Moving the player body through the world: body shape, ground test, step-up and step-down, slopes, jumping, gait and speed."}
