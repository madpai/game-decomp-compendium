{"id":"subsystem:triggers-phantoms","name":"Triggers and phantoms","aliases":["triggers","phantoms","phantom","trigger volumes"],"cues":["trigger","triggers","volume","overlap","zone","region","enter","leave"],"summary":"Volumes that report overlap without blocking: trigger boxes, scripted regions, detection."}
{"id":"subsystem:ragdoll-constraints","name":"Ragdoll and constraints","aliases":["ragdoll","constraints","joints","ragdoll constraints"],"cues":["ragdoll","constraint","joint","hinge","limp","corpse","flop","explodes","stretches"],"summary":"Constrained rigid-body chains (ragdolls, hinges, springs) blended with animation."}
{"id":"subsystem:animation","name":"Animation and skeletons","aliases":["animation","animations","skeleton","skeletal animation","KF","bones","bone names"],"cues":["animation","animations","animated","skeleton","bones","bone","t-pose","tpose","t pose","idle","retarget","pose","kf","keyframe","skinned","skinning","attachment","attach"],"summary":"Skeleton node trees, keyframe sequences (KF), skinning and part attachment."}
